{
  "expo": {
    "name": "DealStasher",
    "slug": "dealstasher",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dealstasher",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:dealstasher.com",
        "applinks:www.dealstasher.com"
      ]
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "dealstasher.com",
              "pathPrefix": "/inbox"
            },
            {
              "scheme": "https",
              "host": "www.dealstasher.com",
              "pathPrefix": "/inbox"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
